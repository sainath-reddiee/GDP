# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================================
# Snowflake Configuration
# ===========================================

# Your Snowflake account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=your_account.region

# Snowflake username (service account or regular user)
SNOWFLAKE_USER=DBT_SERVICE_USER

# Warehouse for compute
SNOWFLAKE_WAREHOUSE=DBT_GENERATOR_WH

# Database (must be created before deployment)
SNOWFLAKE_DATABASE=DBT_GENERATOR

# Schema (must be created before deployment)
SNOWFLAKE_SCHEMA=APP

# Role assigned to the user
SNOWFLAKE_ROLE=DBT_SERVICE_ROLE

# ===========================================
# Authentication Method (Choose ONE)
# ===========================================

# Option A: Private Key Authentication (RECOMMENDED)
# Path inside the container (don't change this)
SNOWFLAKE_PRIVATE_KEY_PATH=/app/snowflake_key.p8
# Passphrase for encrypted private key (leave empty if no passphrase)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Leave password empty when using private key
SNOWFLAKE_PASSWORD=

# Option B: Password Authentication
# Uncomment and set password, comment out private key settings above
# SNOWFLAKE_PASSWORD=<YOUR_STRONG_PASSWORD>
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ===========================================
# AI Settings (Snowflake Cortex)
# ===========================================

# Cortex model for AI-powered transformations
# Default: openai-gpt-5 (Snowflake Cortex OpenAI GPT-5 model)
CORTEX_MODEL=openai-gpt-5

# ===========================================
# Application Settings
# ===========================================

# Application name displayed in UI
APP_NAME=VelocityDBT

# Environment: development or production
ENVIRONMENT=production

# Debug mode (true for development, false for production)
DEBUG=false

# Logging level
LOG_LEVEL=info

# Frontend Settings (Build Time)
VITE_API_BASE_URL=/api
