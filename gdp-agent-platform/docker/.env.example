# Compose-level settings (copy to docker/.env), read by `docker compose --env-file docker/.env`.
# Image tag for this release
GDP_TAG=v1.0
# Commit of the release: git rev-parse --short HEAD
GDP_BUILD_SHA=
# Registry prefix when pushing images, e.g. <registry>/<project>
GDP_REGISTRY=gdp
# Must be pat outside a developer laptop
AIP_AUTH=pat
# Host loopback port the HTTPS reverse proxy forwards to
WEB_PORT=3000
# JSON catalog hide lists, empty for none
NEXT_PUBLIC_CATALOG_DISPLAY=
