# API and worker settings (copy to docker/api.env). Never commit the filled copy.
AIP_AUTH=pat
AIP_ACCOUNT=<account identifier>
AIP_DATABASE=<CLIENT>_AI_PLATFORM
AIP_WAREHOUSE=<WAREHOUSE>
AIP_SUPER_ADMINS=<USER1>,<USER2>
AIP_SECRET_KEY=<32+ random chars>

# worker and system jobs: key-pair service user (the key file is the compose secret docker/secrets/aip_service_key.p8)
AIP_SERVICE_USER=AIP_SERVICE
AIP_SERVICE_KEY_PASSPHRASE=<passphrase>
AIP_SERVICE_ROLE=AIP_SERVICE_ROLE
AIP_SERVICE_WAREHOUSE=<WAREHOUSE>

# Jira, only if in scope
JIRA_CLIENT_SECRET=
JIRA_TOKEN_KEY=
JIRA_REDIRECT_URI=https://<web host>/bff/jira/callback
JIRA_BOT_EMAIL=
JIRA_BOT_TOKEN=

# Airflow on Amazon MWAA (Operations): the API and worker use the default AWS credential chain, never keys in the app.
# Best: an instance role (EC2, with the metadata hop limit at 2 for containers) or a task role (ECS) that has
# airflow:InvokeRestApi, airflow:GetEnvironment, logs:FilterLogEvents and logs:GetLogEvents. Then only the region:
AWS_REGION=<aws region, e.g. us-east-1>
# Only when no role can be attached, an access key of a dedicated IAM user (rotate it; never a person's key):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Self-hosted Airflow instead of MWAA: AIP_AIRFLOW_<ENV ID>_USER and AIP_AIRFLOW_<ENV ID>_PASSWORD per environment.

# Datadog (Operations: incident logs, AI diagnosis, monitors as incidents). Switch it on in Admin, Integrations, Datadog.
# The application key needs the scopes logs_read_data and monitors_read; nothing else.
DATADOG_SITE=<datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com>
DATADOG_API_KEY=
DATADOG_APP_KEY=
# optional, for links only: your custom Datadog web address (default https://app.<DATADOG_SITE>)
DATADOG_APP_URL=

AIP_WORKER_LOG_LEVEL=INFO
