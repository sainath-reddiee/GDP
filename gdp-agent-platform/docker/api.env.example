# API and worker settings (copy to docker/api.env). Never commit the filled copy.
AIP_AUTH=pat
AIP_ACCOUNT=<account identifier>
AIP_DATABASE=<CLIENT>_AI_PLATFORM
AIP_WAREHOUSE=<WAREHOUSE>
AIP_SUPER_ADMINS=<USER1>,<USER2>
AIP_SECRET_KEY=<32+ random chars>

# worker and system jobs: key-pair service user (the key file is the compose secret docker/secrets/aip_service_key.p8)
AIP_SERVICE_USER=AIP_SERVICE
AIP_SERVICE_KEY_PASSPHRASE=<passphrase>
AIP_SERVICE_ROLE=AIP_SERVICE_ROLE
AIP_SERVICE_WAREHOUSE=<WAREHOUSE>

# Jira, only if in scope
JIRA_CLIENT_SECRET=
JIRA_TOKEN_KEY=
JIRA_REDIRECT_URI=https://<web host>/bff/jira/callback
JIRA_BOT_EMAIL=
JIRA_BOT_TOKEN=

AIP_WORKER_LOG_LEVEL=INFO
