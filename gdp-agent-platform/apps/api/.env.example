# Copy to apps/api/.env (gitignored) and fill in. Never commit the real file.
# Variables already set in the process environment win over this file.

# Snowflake (defaults shown)
AIP_AUTH=dev
AIP_SNOWFLAKE_CONNECTION=anblicksorg-anblicksorg_aws
AIP_DATABASE=DEV_AI_PLATFORM
AIP_WAREHOUSE=DBT_WH

# Encryption key for push secrets and Teams webhooks (32+ random characters; keep it stable)
AIP_SECRET_KEY=

# Jira OAuth app (Admin, Integrations, Jira holds the site, client id and redirect)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Encrypts stored Jira tokens (32+ random characters; changing it disconnects everyone)
JIRA_TOKEN_KEY=
JIRA_REDIRECT_URI=http://localhost:3011/bff/jira/callback

# Jira bot for automated incident tickets (an Atlassian API token)
JIRA_BOT_EMAIL=
JIRA_BOT_TOKEN=

# Service identity for the worker in PAT mode (key pair; not needed with AIP_AUTH=dev)
AIP_SERVICE_USER=
AIP_SERVICE_KEY_PATH=
AIP_SERVICE_KEY_PASSPHRASE=
AIP_SERVICE_ROLE=
AIP_SERVICE_WAREHOUSE=

# AWS access for MWAA comes from the default chain (IAM role or AWS_PROFILE), never from this file
# AWS_PROFILE=
