# Copy to apps/api/.env (gitignored) and fill in. Never commit the real file.
# Variables already set in the process environment win over this file.

# Snowflake (defaults shown)
AIP_AUTH=dev
AIP_SNOWFLAKE_CONNECTION=anblicksorg-anblicksorg_aws
AIP_DATABASE=DEV_AI_PLATFORM
AIP_WAREHOUSE=DBT_WH

# Encryption key for push secrets and other ops secrets (32+ random characters; keep it stable)
AIP_SECRET_KEY=

# Jira OAuth app (Admin, Integrations, Jira holds the site, client id and redirect)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Encrypts stored Jira tokens (32+ random characters; changing it disconnects everyone)
JIRA_TOKEN_KEY=
JIRA_REDIRECT_URI=http://localhost:3011/bff/jira/callback

# Jira bot for automated incident tickets (an Atlassian API token)
JIRA_BOT_EMAIL=
JIRA_BOT_TOKEN=

# Service identity for the worker in PAT mode (key pair; not needed with AIP_AUTH=dev)
AIP_SERVICE_USER=
AIP_SERVICE_KEY_PATH=
AIP_SERVICE_KEY_PASSPHRASE=
AIP_SERVICE_ROLE=
AIP_SERVICE_WAREHOUSE=

# ---------------------------------------------------------------- Airflow (Amazon MWAA), for Operations
# The platform reads DAGs, runs and task logs through MWAA's Airflow REST API (boto3 invoke_rest_api), signed with the
# default AWS credential chain. The MWAA environment itself is added in the app, not here: Admin, Integrations,
# Airflow, Add environment, kind MWAA, name (e.g. GDP-MWAA-NonProd) and region.
# The identity needs airflow:InvokeRestApi, airflow:GetEnvironment, logs:FilterLogEvents and logs:GetLogEvents
# (docs/operations-mwaa-datadog.md has the policy). Check it with:
#   python infrastructure/ops_check.py --mwaa-env <MWAA environment name> --region <region>
AWS_REGION=us-east-1
# Sign in with ONE of these, best first:
#   1. a role on the host (EC2 instance profile, ECS task role): set nothing more.
#   2. a named profile from ~/.aws, for a laptop (run `aws sso login --profile <name>` first):
# AWS_PROFILE=<profile name>
#   3. keys of a dedicated IAM user, only when no role can be attached (rotate them; never a person's keys):
# AWS_ACCESS_KEY_ID=<access key id>
# AWS_SECRET_ACCESS_KEY=<secret access key>
#      temporary keys from the AWS access portal (ASIA...) also need their token; they expire within hours, so they
#      suit a one-off check, not the worker:
# AWS_SESSION_TOKEN=<session token>
# Self-hosted Airflow instead of MWAA (Admin, Airflow, kind Airflow): one pair per environment id, upper case, other
# characters as _ (environment id 'prod-eu' -> AIP_AIRFLOW_PROD_EU_USER):
# AIP_AIRFLOW_<ENV_ID>_USER=<airflow user>
# AIP_AIRFLOW_<ENV_ID>_PASSWORD=<airflow password>

# ---------------------------------------------------------------- Datadog, for Operations
# Failed tasks' error logs (then known fix or root-cause analysis), the logs panel on incidents, logs for the AI
# diagnosis, and monitors as incidents. After filling these, restart the API and the worker, then switch Datadog on in
# Admin, Integrations, Datadog. Check it with: python infrastructure/ops_check.py --datadog
# Site: your Datadog web address without https:// and app.
#   app.datadoghq.com -> datadoghq.com     us3.datadoghq.com -> us3.datadoghq.com     us5.datadoghq.com -> us5.datadoghq.com
#   app.datadoghq.eu  -> datadoghq.eu      ap1.datadoghq.com -> ap1.datadoghq.com     app.ddog-gov.com  -> ddog-gov.com
DATADOG_SITE=datadoghq.com
# Organization Settings, API Keys (32 characters)
DATADOG_API_KEY=
# Organization Settings, Application Keys (40 characters); give it only the scopes logs_read_data and monitors_read
DATADOG_APP_KEY=
# Optional, used for links only: your Datadog web address when it is a custom subdomain, e.g. https://acme.datadoghq.com
DATADOG_APP_URL=
# Optional: keep log searches to the pipelines' own logs when one Datadog organisation holds many apps. Comma
# separated, * as a wildcard. Shown in the app only as a count; Admin, Integrations, Datadog can set its own instead.
#   DATADOG_HOST=ip-10-0-1-5, mwaa-worker-*        the host tag of the pipelines' logs
#   DATADOG_SERVICE=airflow, gdp-pipelines          the service tag of the pipelines' logs
DATADOG_HOST=
DATADOG_SERVICE=
